{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GeoVision: Web app",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "GeoVision: Prepare data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "GeoVision: Train model",
      "type": "debugpy",
      "request": "launch",
      "module": "geovision.train",
      "args": ["--set", "model.img_size=64", "train.epochs=5"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "GeoVision: Evaluate model",
      "type": "debugpy",
      "request": "launch",
      "module": "geovision.evaluate",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "GeoVision: Grad-CAM gallery",
      "type": "debugpy",
      "request": "launch",
      "module": "geovision.explain",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "GeoVision: Streamlit dashboard (old UI)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/dashboard.py", "--server.headless", "true"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
